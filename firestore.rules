rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email_verified == true &&
             ('email' in request.auth.token) &&
             request.auth.token.email == 'goldsonawane@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
             (isSignedIn() &&
              exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true);
    }

    function isSuperAdmin() {
      return isBootstrappedAdmin() ||
             (isAdmin() &&
              get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SUPER_ADMIN');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'customUserId', 'fullName', 'kycStatus', 'accountStatus', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'userId', 'customUserId', 'fullName', 'mobileNumber', 'countryCode', 'email',
               'dob', 'address', 'state', 'city', 'pincode', 'panMasked', 'photoUri',
               'kycStatus', 'accountStatus', 'mpinHash', 'mpinSalt', 'biometricEnabled',
               'referralCode', 'referredByCode', 'notifSoundEnabled', 'notifVibrationEnabled',
               'notifPriceAlerts', 'notifAnnouncements', 'qrToken', 'createdAt', 'updatedAt'
             ]) &&
             data.userId == userId &&
             data.customUserId is string && data.customUserId.size() >= 4 && data.customUserId.size() <= 32 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             (!('mobileNumber' in data) || (data.mobileNumber is string && data.mobileNumber.size() <= 20)) &&
             (!('countryCode' in data) || (data.countryCode is string && data.countryCode.size() <= 8)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('dob' in data) || (data.dob is string && data.dob.size() <= 30)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
             (!('state' in data) || (data.state is string && data.state.size() <= 60)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 60)) &&
             (!('pincode' in data) || (data.pincode is string && data.pincode.size() <= 12)) &&
             (!('panMasked' in data) || (data.panMasked is string && data.panMasked.size() <= 20)) &&
             (!('photoUri' in data) || (data.photoUri is string && data.photoUri.size() <= 500)) &&
             data.kycStatus in ['NOT_STARTED', 'PENDING', 'UNDER_REVIEW', 'APPROVED', 'REJECTED', 'INFO_REQUIRED'] &&
             data.accountStatus in ['ACTIVE', 'SUSPENDED', 'BLOCKED'] &&
             (!('mpinHash' in data) || (data.mpinHash is string && data.mpinHash.size() <= 128)) &&
             (!('mpinSalt' in data) || (data.mpinSalt is string && data.mpinSalt.size() <= 64)) &&
             (!('biometricEnabled' in data) || data.biometricEnabled is bool) &&
             (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 32)) &&
             (!('referredByCode' in data) || (data.referredByCode is string && data.referredByCode.size() <= 32)) &&
             (!('notifSoundEnabled' in data) || data.notifSoundEnabled is bool) &&
             (!('notifVibrationEnabled' in data) || data.notifVibrationEnabled is bool) &&
             (!('notifPriceAlerts' in data) || data.notifPriceAlerts is bool) &&
             (!('notifAnnouncements' in data) || data.notifAnnouncements is bool) &&
             (!('qrToken' in data) || (data.qrToken is string && data.qrToken.size() <= 200)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDirectoryEntry(data) {
      return data.keys().hasAll(['uid', 'displayName', 'customUserId', 'mobileLast4', 'kycApproved', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'displayName', 'customUserId', 'mobileLast4', 'kycApproved', 'updatedAt']) &&
             isValidId(data.uid) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.customUserId is string && data.customUserId.size() >= 4 && data.customUserId.size() <= 32 &&
             data.mobileLast4 is string && data.mobileLast4.size() <= 4 &&
             data.kycApproved is bool &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWallet(data, userId) {
      return data.keys().hasAll([
               'userId', 'availableInr', 'pendingInr', 'lockedInr',
               'gold24kGrams', 'gold22kGrams', 'gold18kGrams', 'silver999Grams',
               'totalInvestedGoldInr', 'totalInvestedSilverInr', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'availableInr', 'pendingInr', 'lockedInr',
               'gold24kGrams', 'gold22kGrams', 'gold18kGrams', 'silver999Grams',
               'totalInvestedGoldInr', 'totalInvestedSilverInr', 'updatedAt'
             ]) &&
             data.userId == userId &&
             data.availableInr is number && data.availableInr >= 0 &&
             data.pendingInr is number && data.pendingInr >= 0 &&
             data.lockedInr is number && data.lockedInr >= 0 &&
             data.gold24kGrams is number && data.gold24kGrams >= 0 &&
             data.gold22kGrams is number && data.gold22kGrams >= 0 &&
             data.gold18kGrams is number && data.gold18kGrams >= 0 &&
             data.silver999Grams is number && data.silver999Grams >= 0 &&
             data.totalInvestedGoldInr is number && data.totalInvestedGoldInr >= 0 &&
             data.totalInvestedSilverInr is number && data.totalInvestedSilverInr >= 0 &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidLedgerEntry(data, userId) {
      return data.keys().hasAll(['userId', 'entryType', 'assetType', 'deltaAmount', 'balanceAfter', 'referenceId', 'idempotencyKey', 'description', 'mode', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'entryType', 'assetType', 'deltaAmount', 'balanceAfter', 'referenceId', 'idempotencyKey', 'description', 'mode', 'createdAt']) &&
             data.userId == userId &&
             data.entryType is string && data.entryType.size() >= 2 && data.entryType.size() <= 40 &&
             data.assetType is string && data.assetType.size() >= 2 && data.assetType.size() <= 30 &&
             data.deltaAmount is number &&
             data.balanceAfter is number && data.balanceAfter >= 0 &&
             data.referenceId is string && data.referenceId.size() >= 1 && data.referenceId.size() <= 100 &&
             data.idempotencyKey is string && data.idempotencyKey.size() >= 4 && data.idempotencyKey.size() <= 100 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 240 &&
             data.mode in ['TEST', 'LIVE'] &&
             isValidTimestamp(data.createdAt);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
               'userId', 'txCode', 'category', 'metalPurity', 'grams', 'ratePerGram',
               'baseAmount', 'gstAmount', 'chargesAmount', 'totalAmount', 'paymentMethod',
               'gatewayOrderId', 'gatewayRef', 'status', 'mode', 'idempotencyKey', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'counterpartyUid', 'counterpartyName', 'txCode', 'category',
               'metalPurity', 'grams', 'ratePerGram', 'baseAmount', 'gstAmount', 'chargesAmount',
               'totalAmount', 'paymentMethod', 'gatewayOrderId', 'gatewayRef', 'status', 'mode',
               'bankAccountId', 'bankNameMasked', 'rejectionReason', 'idempotencyKey', 'createdAt', 'updatedAt'
             ]) &&
             isValidId(data.userId) &&
             (!('counterpartyUid' in data) || (data.counterpartyUid is string && data.counterpartyUid.size() <= 128)) &&
             (!('counterpartyName' in data) || (data.counterpartyName is string && data.counterpartyName.size() <= 100)) &&
             data.txCode is string && data.txCode.size() >= 4 && data.txCode.size() <= 64 &&
             data.category in ['GOLD_BUY', 'GOLD_SELL', 'SILVER_BUY', 'SILVER_SELL', 'DEPOSIT', 'WITHDRAWAL', 'TRANSFER_SENT', 'TRANSFER_RECEIVED', 'REFUND', 'REWARD'] &&
             data.metalPurity in ['24K', '22K', '18K', '999', 'NONE'] &&
             data.grams is number && data.grams >= 0 &&
             data.ratePerGram is number && data.ratePerGram >= 0 &&
             data.baseAmount is number && data.baseAmount >= 0 &&
             data.gstAmount is number && data.gstAmount >= 0 &&
             data.chargesAmount is number && data.chargesAmount >= 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.paymentMethod is string && data.paymentMethod.size() >= 2 && data.paymentMethod.size() <= 40 &&
             data.gatewayOrderId is string && data.gatewayOrderId.size() >= 1 && data.gatewayOrderId.size() <= 100 &&
             data.gatewayRef is string && data.gatewayRef.size() >= 1 && data.gatewayRef.size() <= 100 &&
             data.status in ['PENDING', 'PROCESSING', 'SUCCESSFUL', 'FAILED', 'REVERSED', 'REFUNDED'] &&
             data.mode in ['TEST', 'LIVE'] &&
             (!('bankAccountId' in data) || (data.bankAccountId is string && data.bankAccountId.size() <= 128)) &&
             (!('bankNameMasked' in data) || (data.bankNameMasked is string && data.bankNameMasked.size() <= 80)) &&
             (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 240)) &&
             data.idempotencyKey is string && data.idempotencyKey.size() >= 4 && data.idempotencyKey.size() <= 100 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBankAccount(data, userId) {
      return data.keys().hasAll(['userId', 'accountHolderName', 'bankName', 'accountNumberLast4', 'accountNumberMasked', 'ifscCode', 'verificationStatus', 'isPrimary', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'accountHolderName', 'bankName', 'accountNumberLast4', 'accountNumberMasked', 'ifscCode', 'verificationStatus', 'isPrimary', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.accountHolderName is string && data.accountHolderName.size() >= 2 && data.accountHolderName.size() <= 100 &&
             data.bankName is string && data.bankName.size() >= 2 && data.bankName.size() <= 80 &&
             data.accountNumberLast4 is string && data.accountNumberLast4.size() == 4 &&
             data.accountNumberMasked is string && data.accountNumberMasked.size() >= 4 && data.accountNumberMasked.size() <= 30 &&
             data.ifscCode is string && data.ifscCode.size() == 11 &&
             data.verificationStatus in ['PENDING', 'VERIFIED', 'REJECTED'] &&
             data.isPrimary is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidKycRecord(data, userId) {
      return data.keys().hasAll(['userId', 'userName', 'mobileNumber', 'panNumber', 'aadhaarLast4', 'documentType', 'addressLine', 'state', 'city', 'pincode', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'userId', 'userName', 'mobileNumber', 'panNumber', 'aadhaarLast4', 'documentType',
               'documentRefUri', 'documentFrontBase64', 'documentBackBase64', 'captureMethod',
               'scanQualityScore', 'verificationStep', 'declarationAccepted',
               'addressLine', 'state', 'city', 'pincode', 'status', 'rejectionReason', 'reviewedByAdminId', 'createdAt', 'updatedAt'
             ]) &&
             data.userId == userId &&
             data.userName is string && data.userName.size() >= 2 && data.userName.size() <= 100 &&
             data.mobileNumber is string && data.mobileNumber.size() >= 6 && data.mobileNumber.size() <= 20 &&
             data.panNumber is string && data.panNumber.size() == 10 &&
             data.aadhaarLast4 is string && data.aadhaarLast4.size() == 4 &&
             data.documentType is string && data.documentType.size() >= 2 && data.documentType.size() <= 40 &&
             (!('documentRefUri' in data) || (data.documentRefUri is string && data.documentRefUri.size() <= 500)) &&
             (!('documentFrontBase64' in data) || (data.documentFrontBase64 is string && data.documentFrontBase64.size() <= 120000)) &&
             (!('documentBackBase64' in data) || (data.documentBackBase64 is string && data.documentBackBase64.size() <= 120000)) &&
             (!('captureMethod' in data) || data.captureMethod in ['CAMERAX_SCAN', 'PHOTO_PICKER']) &&
             (!('scanQualityScore' in data) || (data.scanQualityScore is int && data.scanQualityScore >= 0 && data.scanQualityScore <= 100)) &&
             (!('verificationStep' in data) || (data.verificationStep is int && data.verificationStep >= 1 && data.verificationStep <= 3)) &&
             (!('declarationAccepted' in data) || data.declarationAccepted is bool) &&
             data.addressLine is string && data.addressLine.size() >= 3 && data.addressLine.size() <= 300 &&
             data.state is string && data.state.size() >= 2 && data.state.size() <= 60 &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 60 &&
             data.pincode is string && data.pincode.size() >= 4 && data.pincode.size() <= 12 &&
             data.status in ['NOT_STARTED', 'PENDING', 'UNDER_REVIEW', 'APPROVED', 'REJECTED', 'INFO_REQUIRED'] &&
             (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 300)) &&
             (!('reviewedByAdminId' in data) || (data.reviewedByAdminId is string && data.reviewedByAdminId.size() <= 128)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDeviceSession(data, userId) {
      return data.keys().hasAll(['userId', 'deviceName', 'deviceModel', 'osVersion', 'sessionActive', 'lastActiveAt', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'deviceName', 'deviceModel', 'osVersion', 'sessionActive', 'lastActiveAt', 'createdAt']) &&
             data.userId == userId &&
             data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 100 &&
             data.deviceModel is string && data.deviceModel.size() >= 1 && data.deviceModel.size() <= 100 &&
             data.osVersion is string && data.osVersion.size() >= 1 && data.osVersion.size() <= 40 &&
             data.sessionActive is bool &&
             isValidTimestamp(data.lastActiveAt) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidLoginHistory(data, userId) {
      return data.keys().hasAll(['userId', 'deviceName', 'status', 'method', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'deviceName', 'status', 'method', 'createdAt']) &&
             data.userId == userId &&
             data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 100 &&
             data.status is string && data.status.size() >= 2 && data.status.size() <= 40 &&
             data.method is string && data.method.size() >= 2 && data.method.size() <= 40 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidPriceAlert(data, userId) {
      return data.keys().hasAll(['userId', 'metal', 'targetPriceInr', 'direction', 'frequency', 'isActive', 'triggerCount', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'metal', 'targetPriceInr', 'direction', 'frequency', 'isActive', 'notes', 'triggerCount', 'lastTriggeredPrice', 'lastObservedPrice', 'triggeredAt', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.metal in ['GOLD_24K', 'GOLD_22K', 'GOLD_18K', 'SILVER_999'] &&
             data.targetPriceInr is number && data.targetPriceInr > 0 &&
             data.direction in ['ABOVE', 'BELOW', 'CROSSES'] &&
             data.frequency in ['ONCE', 'EVERY_HOUR', 'DAILY', 'ALWAYS'] &&
             data.isActive is bool &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 160)) &&
             data.triggerCount is int && data.triggerCount >= 0 &&
             (!('lastTriggeredPrice' in data) || (data.lastTriggeredPrice is number && data.lastTriggeredPrice >= 0)) &&
             (!('lastObservedPrice' in data) || (data.lastObservedPrice is number && data.lastObservedPrice >= 0)) &&
             (!('triggeredAt' in data) || isValidTimestamp(data.triggeredAt)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNotification(data, userId) {
      return data.keys().hasAll(['userId', 'type', 'title', 'body', 'isRead', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'type', 'title', 'body', 'isRead', 'referenceId', 'createdAt']) &&
             data.userId == userId &&
             data.type is string && data.type.size() >= 2 && data.type.size() <= 50 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 500 &&
             data.isRead is bool &&
             (!('referenceId' in data) || (data.referenceId is string && data.referenceId.size() <= 128)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidTransfer(data) {
      return data.keys().hasAll(['senderUid', 'senderName', 'recipientUid', 'recipientName', 'transferCode', 'assetType', 'quantity', 'feeInr', 'status', 'recipientCredited', 'idempotencyKey', 'createdAt']) &&
             data.keys().hasOnly(['senderUid', 'senderName', 'recipientUid', 'recipientName', 'transferCode', 'assetType', 'quantity', 'feeInr', 'status', 'recipientCredited', 'idempotencyKey', 'createdAt']) &&
             isValidId(data.senderUid) &&
             isValidId(data.recipientUid) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
             data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 100 &&
             data.transferCode is string && data.transferCode.size() >= 4 && data.transferCode.size() <= 64 &&
             data.assetType in ['INR', 'GOLD_24K', 'GOLD_22K', 'GOLD_18K', 'SILVER_999'] &&
             data.quantity is number && data.quantity > 0 &&
             data.feeInr is number && data.feeInr >= 0 &&
             data.status in ['COMPLETED', 'FAILED', 'FLAGGED'] &&
             data.recipientCredited is bool &&
             data.idempotencyKey is string && data.idempotencyKey.size() >= 4 && data.idempotencyKey.size() <= 100 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['userId', 'userName', 'ticketCode', 'category', 'subject', 'description', 'status', 'messages', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'userName', 'ticketCode', 'category', 'subject', 'description', 'attachmentUri', 'status', 'assignedAdminId', 'messages', 'createdAt', 'updatedAt']) &&
             isValidId(data.userId) &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
             data.ticketCode is string && data.ticketCode.size() >= 4 && data.ticketCode.size() <= 40 &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 60 &&
             data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 150 &&
             data.description is string && data.description.size() >= 2 && data.description.size() <= 2000 &&
             (!('attachmentUri' in data) || (data.attachmentUri is string && data.attachmentUri.size() <= 500)) &&
             data.status in ['OPEN', 'IN_PROGRESS', 'WAITING_FOR_USER', 'RESOLVED', 'CLOSED'] &&
             (!('assignedAdminId' in data) || (data.assignedAdminId is string && data.assignedAdminId.size() <= 128)) &&
             data.messages is list && data.messages.size() <= 50 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidReferral(data) {
      return data.keys().hasAll(['referrerUid', 'referredUid', 'referredName', 'referralCode', 'rewardAmountInr', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['referrerUid', 'referredUid', 'referredName', 'referralCode', 'rewardAmountInr', 'status', 'createdAt', 'updatedAt']) &&
             isValidId(data.referrerUid) &&
             isValidId(data.referredUid) &&
             data.referredName is string && data.referredName.size() >= 1 && data.referredName.size() <= 100 &&
             data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 32 &&
             data.rewardAmountInr is number && data.rewardAmountInr >= 0 &&
             data.status in ['PENDING', 'ELIGIBLE', 'CREDITED', 'CANCELLED'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'permissions', 'isActive', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'operatorId', 'role', 'permissions', 'isActive', 'adminPinHash', 'biometricAdminEnabled', 'lastLoginAt', 'createdAt', 'updatedAt']) &&
             isValidId(data.uid) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('operatorId' in data) || (data.operatorId is string && data.operatorId.size() <= 32)) &&
             data.role in ['SUPER_ADMIN', 'ADMIN', 'FINANCE_MANAGER', 'KYC_MANAGER', 'CUSTOMER_SUPPORT', 'READ_ONLY_AUDITOR'] &&
             data.permissions is list && data.permissions.size() <= 20 &&
             data.isActive is bool &&
             (!('adminPinHash' in data) || (data.adminPinHash is string && data.adminPinHash.size() <= 128)) &&
             (!('biometricAdminEnabled' in data) || data.biometricAdminEnabled is bool) &&
             (!('lastLoginAt' in data) || isValidTimestamp(data.lastLoginAt)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['adminUid', 'adminEmail', 'adminRole', 'action', 'affectedCollection', 'affectedRecordId', 'previousValue', 'newValue', 'reason', 'deviceInfo', 'createdAt']) &&
             data.keys().hasOnly(['adminUid', 'adminEmail', 'adminRole', 'action', 'affectedCollection', 'affectedRecordId', 'previousValue', 'newValue', 'reason', 'deviceInfo', 'createdAt']) &&
             isValidId(data.adminUid) &&
             data.adminEmail is string && data.adminEmail.size() <= 120 &&
             data.adminRole is string && data.adminRole.size() <= 40 &&
             data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
             data.affectedCollection is string && data.affectedCollection.size() >= 2 && data.affectedCollection.size() <= 60 &&
             data.affectedRecordId is string && data.affectedRecordId.size() >= 1 && data.affectedRecordId.size() <= 128 &&
             data.previousValue is string && data.previousValue.size() <= 500 &&
             data.newValue is string && data.newValue.size() <= 500 &&
             data.reason is string && data.reason.size() <= 300 &&
             data.deviceInfo is string && data.deviceInfo.size() <= 150 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'message', 'priority', 'createdByUid', 'createdAt']) &&
             data.keys().hasOnly(['title', 'message', 'priority', 'createdByUid', 'createdAt']) &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
             data.message is string && data.message.size() >= 2 && data.message.size() <= 1000 &&
             data.priority in ['INFO', 'IMPORTANT', 'URGENT'] &&
             isValidId(data.createdByUid) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidMarketPriceHistory(data, dateId) {
      return data.keys().hasAll([
               'dateStr', 'label', 'gold24kPerGram', 'gold22kPerGram',
               'gold18kPerGram', 'silver999PerGram', 'source', 'timestampEpochMs',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'dateStr', 'label', 'gold24kPerGram', 'gold22kPerGram',
               'gold18kPerGram', 'silver999PerGram', 'source', 'timestampEpochMs',
               'createdAt', 'updatedAt'
             ]) &&
             data.dateStr == dateId &&
             data.dateStr is string && data.dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 24 &&
             data.gold24kPerGram is number && data.gold24kPerGram > 0 && data.gold24kPerGram <= 100000 &&
             data.gold22kPerGram is number && data.gold22kPerGram > 0 && data.gold22kPerGram <= 100000 &&
             data.gold18kPerGram is number && data.gold18kPerGram > 0 && data.gold18kPerGram <= 100000 &&
             data.silver999PerGram is number && data.silver999PerGram > 0 && data.silver999PerGram <= 10000 &&
             data.source is string && data.source.size() >= 2 && data.source.size() <= 120 &&
             data.timestampEpochMs is int && data.timestampEpochMs > 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- COLLECTIONS ---

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().kycStatus == 'NOT_STARTED' &&
                       incoming().accountStatus == 'ACTIVE';

      allow update: if isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().customUserId == existing().customUserId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           isOwner(userId) &&
                           incoming().accountStatus == existing().accountStatus &&
                           (incoming().kycStatus == existing().kycStatus || incoming().kycStatus in ['PENDING', 'UNDER_REVIEW']) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'fullName', 'mobileNumber', 'countryCode', 'email', 'dob', 'address',
                             'state', 'city', 'pincode', 'panMasked', 'photoUri', 'kycStatus',
                             'mpinHash', 'mpinSalt', 'biometricEnabled', 'referredByCode',
                             'notifSoundEnabled', 'notifVibrationEnabled', 'notifPriceAlerts',
                             'notifAnnouncements', 'qrToken', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isAdmin();

      match /wallets/{walletId} {
        allow get: if isValidId(walletId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(walletId) && (isOwner(userId) || isAdmin()) && isValidWallet(incoming(), userId);
        allow update: if isValidId(walletId) && (isOwner(userId) || isAdmin()) && isValidWallet(incoming(), userId);
        allow delete: if false;
      }

      match /ledger/{entryId} {
        allow get: if isValidId(entryId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(entryId) && (isOwner(userId) || isAdmin()) && isValidLedgerEntry(incoming(), userId);
        allow update, delete: if false;
      }

      match /bank_accounts/{bankId} {
        allow get: if isValidId(bankId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(bankId) && (isOwner(userId) || isAdmin()) && isValidBankAccount(incoming(), userId);
        allow update: if isValidId(bankId) && (isOwner(userId) || isAdmin()) && isValidBankAccount(incoming(), userId) && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(bankId) && (isOwner(userId) || isAdmin());
      }

      match /devices/{deviceId} {
        allow get: if isValidId(deviceId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create, update: if isValidId(deviceId) && (isOwner(userId) || isAdmin()) && isValidDeviceSession(incoming(), userId);
        allow delete: if isValidId(deviceId) && (isOwner(userId) || isAdmin());
      }

      match /login_history/{loginId} {
        allow get: if isValidId(loginId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(loginId) && (isOwner(userId) || isAdmin()) && isValidLoginHistory(incoming(), userId);
        allow update, delete: if false;
      }

      match /price_alerts/{alertId} {
        allow get: if isValidId(alertId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create, update: if isValidId(alertId) && (isOwner(userId) || isAdmin()) && isValidPriceAlert(incoming(), userId);
        allow delete: if isValidId(alertId) && (isOwner(userId) || isAdmin());
      }

      match /notifications/{notifId} {
        allow get: if isValidId(notifId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(notifId) && (isOwner(userId) || isAdmin()) && isValidNotification(incoming(), userId);
        allow update: if isValidId(notifId) && (isOwner(userId) || isAdmin()) && isValidNotification(incoming(), userId) && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
        allow delete: if isValidId(notifId) && (isOwner(userId) || isAdmin());
      }
    }

    match /user_directory/{lookupKey} {
      allow get: if isSignedIn() && isValidId(lookupKey);
      allow list: if false;
      allow create, update: if isSignedIn() && isValidId(lookupKey) && isValidDirectoryEntry(incoming()) && (incoming().uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (
        existing().userId == request.auth.uid ||
        ('counterpartyUid' in existing() && existing().counterpartyUid == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(txId) && isValidTransaction(incoming()) && (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(txId) && isValidTransaction(incoming()) &&
                       isAdmin() &&
                       existing().status in ['PENDING', 'PROCESSING'] &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'gatewayRef', 'rejectionReason', 'updatedAt']);
      allow delete: if false;
    }

    match /kyc_records/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidKycRecord(incoming(), userId) &&
                       incoming().status in ['PENDING', 'UNDER_REVIEW'];
      allow update: if isValidId(userId) &&
                       isValidKycRecord(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           isOwner(userId) &&
                           existing().status in ['NOT_STARTED', 'REJECTED', 'INFO_REQUIRED'] &&
                           incoming().status in ['PENDING', 'UNDER_REVIEW']
                         )
                       );
      allow delete: if false;
    }

    match /transfers/{transferId} {
      allow get: if isSignedIn() && isValidId(transferId) && (
        existing().senderUid == request.auth.uid ||
        existing().recipientUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().senderUid == request.auth.uid ||
        existing().recipientUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(transferId) &&
                       isValidTransfer(incoming()) &&
                       incoming().senderUid == request.auth.uid &&
                       incoming().recipientUid != request.auth.uid &&
                       incoming().recipientCredited == false;
      allow update: if isSignedIn() && isValidId(transferId) &&
                       isValidTransfer(incoming()) &&
                       incoming().senderUid == existing().senderUid &&
                       incoming().recipientUid == existing().recipientUid &&
                       incoming().quantity == existing().quantity &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           request.auth.uid == existing().recipientUid &&
                           existing().recipientCredited == false &&
                           incoming().recipientCredited == true &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['recipientCredited'])
                         )
                       );
      allow delete: if false;
    }

    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(ticketId) &&
                       isValidTicket(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'OPEN';
      allow update: if isSignedIn() && isValidId(ticketId) &&
                       isValidTicket(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           existing().userId == request.auth.uid &&
                           existing().status != 'CLOSED' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'status', 'updatedAt'])
                         )
                       );
      allow delete: if false;
    }

    match /referrals/{referralId} {
      allow get: if isSignedIn() && isValidId(referralId) && (
        existing().referrerUid == request.auth.uid ||
        existing().referredUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().referrerUid == request.auth.uid ||
        existing().referredUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(referralId) &&
                       isValidReferral(incoming()) &&
                       incoming().referredUid == request.auth.uid &&
                       incoming().referrerUid != request.auth.uid;
      allow update: if isAdmin() && isValidId(referralId) && isValidReferral(incoming());
      allow delete: if false;
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminUid) && isSuperAdmin() && isValidAdminUser(incoming());
      allow update: if isValidId(adminUid) && isValidAdminUser(incoming()) && (
        isSuperAdmin() ||
        (
          isOwner(adminUid) &&
          existing().isActive == true &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          incoming().permissions == existing().permissions &&
          incoming().isActive == existing().isActive &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['operatorId', 'adminPinHash', 'biometricAdminEnabled', 'lastLoginAt', 'updatedAt'])
        )
      );
      allow delete: if isValidId(adminUid) && isSuperAdmin() && existing().email != 'goldsonawane@gmail.com';
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() && isValidAuditLog(incoming()) && incoming().adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /app_config/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if isAdmin();
      allow create, update: if isValidId(configId) && isAdmin();
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow get: if isSignedIn() && isValidId(announcementId);
      allow list: if isSignedIn();
      allow create, update: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming());
      allow delete: if isValidId(announcementId) && isAdmin();
    }

    match /market_price_history/{dateId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(dateId) && isValidMarketPriceHistory(incoming(), dateId);
      allow update: if isAdmin() && isValidId(dateId) && isValidMarketPriceHistory(incoming(), dateId) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }
  }
}
